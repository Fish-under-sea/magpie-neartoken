{
  "name": "@fish-under-sea/magpie-neartoken",
  "version": "0.6.5",
  "description": "NearToken for magpie: an independently installed provider and page plugin with device authorization, one row per model, group routing, balance, usage and top-ups.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./page": "./page/index.html"
  },
  "scripts": {
    "prepack": "node scripts/stamp.mjs"
  },
  "license": "MIT",
  "files": [
    "index.mjs",
    "page",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-provider",
    "magpie-page",
    "opencode-plugin",
    "neartoken",
    "new-api",
    "relay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fish-under-sea/magpie-neartoken.git"
  },
  "homepage": "https://github.com/Fish-under-sea/magpie-neartoken#readme",
  "bugs": {
    "url": "https://github.com/Fish-under-sea/magpie-neartoken/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "magpie": {
    "icon": "page/icon.png",
    "page": {
      "title": "NearToken",
      "titles": {
        "zh": "NearToken",
        "zh-TW": "NearToken",
        "ja": "NearToken",
        "de": "NearToken"
      },
      "file": "page/index.html",
      "icon": "page/star.png"
    },
    "calls": [
      "neartoken:state",
      "neartoken:connect",
      "neartoken:cancel",
      "neartoken:open",
      "neartoken:disconnect",
      "neartoken:refresh",
      "neartoken:usage",
      "neartoken:topup"
    ]
  }
}
